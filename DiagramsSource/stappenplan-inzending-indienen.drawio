<mxfile host="app.diagrams.net" agent="generate-inzending-diagram.py" version="21.0.0">
  <diagram id="stappenplan-inzending-indienen" name="stappenplan-inzending-indienen">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
      <mxCell id="title" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" value="Stappenplan: een inzending indienen en opvolgen" vertex="1" parent="1"><mxGeometry width="1100" x="24" height="20" y="24" as="geometry" /></mxCell>
      <mxCell id="subtitle-1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11.5;" value="Scenario: je publiceert het document (besluit en melding) als RDFa-pagina op de website van je bestuur," vertex="1" parent="1"><mxGeometry width="1100" x="24" height="16" y="48" as="geometry" /></mxCell>
      <mxCell id="subtitle-2" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11.5;" value="dient de melding in bij het Loket en volgt daarna de status van je inzending op tot ze verstuurd is." vertex="1" parent="1"><mxGeometry width="1100" x="24" height="16" y="60" as="geometry" /></mxCell>
      <mxCell id="actor-bp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4a6fa5;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" value="&lt;b&gt;Publicatiepagina&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;website van het bestuur (RDFa)&lt;/font&gt;" vertex="1" parent="1"><mxGeometry width="168" x="48" height="44" y="108" as="geometry" /></mxCell>
      <mxCell id="actor-vendor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4a6fa5;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" value="&lt;b&gt;Vendor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;jouw toepassing&lt;/font&gt;" vertex="1" parent="1"><mxGeometry width="168" x="480" height="44" y="108" as="geometry" /></mxCell>
      <mxCell id="actor-loket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4a6fa5;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" value="&lt;b&gt;Loket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Meldingsplicht en Vendor SPARQL API&lt;/font&gt;" vertex="1" parent="1"><mxGeometry width="168" x="912" height="44" y="108" as="geometry" /></mxCell>
      <mxCell id="lifeline-bp" style="endArrow=none;dashed=1;strokeColor=#c8c8c8;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=640;entryPerimeter=0;" value="" edge="1" parent="1" source="actor-bp" target="actor-bp"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="lifeline-vendor" style="endArrow=none;dashed=1;strokeColor=#c8c8c8;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=640;entryPerimeter=0;" value="" edge="1" parent="1" source="actor-vendor" target="actor-vendor"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="lifeline-loket" style="endArrow=none;dashed=1;strokeColor=#c8c8c8;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=640;entryPerimeter=0;" value="" edge="1" parent="1" source="actor-loket" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-stap-1" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=60;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=60;entryPerimeter=0;" value="&lt;b&gt;Stap 1: publiceer het document als RDFa-pagina&lt;/b&gt;&lt;br&gt;op de website van het bestuur (besluit en melding)" edge="1" parent="1" source="actor-vendor" target="actor-bp"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-stap-2" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=180;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=180;entryPerimeter=0;" value="&lt;b&gt;Stap 2: dien de melding in&lt;/b&gt;&lt;br&gt;POST /melding op de Meldingsplicht API&lt;br&gt;met publisher, sleutel, organisation en href = URL van de pagina uit stap 1&lt;br&gt;antwoord: submission-URI (bewaren voor stap 4)" edge="1" parent="1" source="actor-vendor" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-harvest" style="endArrow=open;dashed=1;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#909090;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=300;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=300;entryPerimeter=0;" value="&lt;b&gt;automatisch: harvest&lt;/b&gt;&lt;br&gt;het Loket haalt de RDFa-pagina op en verwerkt de melding&lt;br&gt;asynchroon, normaal enkele minuten" edge="1" parent="1" source="actor-loket" target="actor-bp"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-stap-3" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=420;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=420;entryPerimeter=0;" value="&lt;b&gt;Stap 3: log in op de Vendor SPARQL API&lt;/b&gt;&lt;br&gt;POST /vendor/login (sessie-cookie)" edge="1" parent="1" source="actor-vendor" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-stap-4" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=540;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=540;entryPerimeter=0;" value="&lt;b&gt;Stap 4: volg de status op&lt;/b&gt;&lt;br&gt;POST /vendor/sparql met de opvolgquery&lt;br&gt;polling: herhaal tot de status 'verstuurd' is" edge="1" parent="1" source="actor-vendor" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-stap-5" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=660;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=660;entryPerimeter=0;" value="&lt;b&gt;Stap 5: log uit&lt;/b&gt;&lt;br&gt;POST /vendor/logout" edge="1" parent="1" source="actor-vendor" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
