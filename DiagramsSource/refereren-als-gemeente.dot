digraph ReferencingAsCKBModel {
  node [shape="box", peripheries=2, margin=0, fontname="Monospace"];
  edge [fontname="Monospace"];
  rankdir="LR";

  SubmissionDocumentGemeente [label=<
    <table border="0" cellspacing="0" cellborder="1">
      <tr>
        <td><b>ext:SubmissionDocument</b></td>
      </tr>
      <tr>
        <td>
          <i>Dit stelt het document van <br align="left" />
een gemeente voor dat <br align="left" />
een document van een <br align="left" />
eredienstbestuur refereert.
          </i>
        </td>
      </tr>
    </table>
  >];

  Artikel [label=<
    <table border="0" cellspacing="0" cellborder="1">
      <tr>
        <td><b>besluit:Artikel</b></td>
      </tr>
      <tr>
        <td balign="left">
          eli:type_document → skos:Concept
        </td>
      </tr>
    </table>
  >];

  SubmissionDocumentCKB [color=grey fontcolor=grey label=<
    <table border="0" cellspacing="0" cellborder="1">
      <tr>
        <td><b>ext:SubmissionDocument</b></td>
      </tr>
      <tr>
        <td>
          <i>Dit stelt het document van <br align="left" />
het CKB voor dat een document <br align="left" />
van een eredienstbestuur <br align="left" />
refereert.
          </i>
        </td>
      </tr>
    </table>
  >];

  SubmissionDocumentEB [label=<
    <table border="0" cellspacing="0" cellborder="1">
      <tr>
        <td><b>ext:SubmissionDocument</b></td>
      </tr>
      <tr>
        <td>
          <i>Dit stelt het document voor <br align="left" />
van het eredienstbestuur.
          </i>
        </td>
      </tr>
    </table>
  >];

  SubmissionDocumentGemeente -> Artikel [label="eli:has_part"];
  Artikel -> SubmissionDocumentEB [label="eli:refers_to"];
  SubmissionDocumentCKB -> SubmissionDocumentEB [color=grey fontcolor=grey label="dct:relation"];
}
