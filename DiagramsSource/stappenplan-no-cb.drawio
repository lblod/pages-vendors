        <mxCell id="title" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" value="Stappenplan: refereren als gemeente of provincie naar een document van een eredienstbestuur zonder centraal bestuur" vertex="1" parent="1"><mxGeometry width="1012" x="24" height="20" y="24" as="geometry" /></mxCell>
      <mxCell id="subtitle-1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11.5;" value="Scenario: je bent de vendor van gemeente Londerzeel en de gemeente wil een advies geven bij de" vertex="1" parent="1"><mxGeometry width="1012" x="24" height="16" y="48" as="geometry" /></mxCell>
      <mxCell id="subtitle-2" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11.5;" value="jaarrekening van de Christengemeente Londerzeel (een protestantse gemeente, zonder CKB)." vertex="1" parent="1"><mxGeometry width="1012" x="24" height="16" y="60" as="geometry" /></mxCell>
      <mxCell id="subtitle-3" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11.5;" value="De jaarrekening bestaat al, de sync van je inzending gebeurt vanzelf." vertex="1" parent="1"><mxGeometry width="1012" x="24" height="16" y="72" as="geometry" /></mxCell>
      <mxCell id="actor-eb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4a6fa5;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" value='&lt;b&gt;Eredienstbestuur&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;bv. een protestantse gemeente&lt;/font&gt;' vertex="1" parent="1"><mxGeometry width="168" height="44" x="48" y="108" as="geometry" /></mxCell>
