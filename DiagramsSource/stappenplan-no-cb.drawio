      <mxCell id="lifeline-loket" style="endArrow=none;dashed=1;strokeColor=#c8c8c8;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=814;entryPerimeter=0;" value="" edge="1" parent="1" source="actor-loket" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-0" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#909090;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=52;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=52;entryPerimeter=0;" value="&lt;b&gt;vooraf&lt;/b&gt;: het eredienstbestuur diende zijn jaarrekening al in&lt;br&gt;(het EB-document, via het Loket of een vendor)&lt;br&gt;Er is geen CKB en geen bundel." edge="1" parent="1" source="actor-eb" target="actor-wdb"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-1" style="endArrow=open;dashed=1;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=172;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=172;entryPerimeter=0;" value="Haal betrokken bestuur op:&lt;br&gt;In dit geval:&lt;br&gt;Christengemeente Londerzeel" edge="1" parent="1" source="actor-cv" target="actor-bs"><mxGeometry relative="1" x="0.0612" y="-34" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      <mxCell id="arrow-2" style="endArrow=open;dashed=1;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=292;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=292;entryPerimeter=0;" value="Controleer of er een centraal bestuur is&lt;br&gt;(via org:hasSubOrganization)&lt;br&gt;In dit geval: geen rij. Geen rij = geen CKB,&lt;br&gt;je zit in de juiste flow." edge="1" parent="1" source="actor-cv" target="actor-bs"><mxGeometry relative="1" x="0.0612" y="-44" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      <mxCell id="arrow-3" style="endArrow=open;dashed=1;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=412;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=412;entryPerimeter=0;" value="Haal het correcte &lt;u&gt;documenttype&lt;/u&gt; op&lt;br&gt;waarnaar gerefereerd kan worden.&lt;br&gt;(via ref:ReferencingRule)&lt;br&gt;In dit geval: 'Jaarrekening'&lt;br&gt;(het eigen document van het eredienstbestuur)" edge="1" parent="1" source="actor-cv" target="actor-bs"><mxGeometry relative="1" x="0.0612" y="-54" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      <mxCell id="arrow-4" style="endArrow=open;dashed=1;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=532;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=532;entryPerimeter=0;" value="Na login, haal de documenten op&lt;br&gt;om er effectief naar te refereren.&lt;br&gt;In dit geval het eigen document van het eredienstbestuur:&lt;br&gt;de jaarrekening van de Christengemeente Londerzeel.&lt;br&gt;Zonder CKB ziet je login die inzending rechtstreeks." edge="1" parent="1" source="actor-wdb" target="actor-bs"><mxGeometry relative="1" x="0.0204" y="-44" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      <mxCell id="arrow-5" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#404040;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=652;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=652;entryPerimeter=0;" value="&lt;b&gt;Publiceer het advies met een Artikel&lt;/b&gt;&lt;br&gt;(eli:refers_to naar de eredienst-document-URI uit vorige stappen)&lt;br&gt;en dien het in via de Meldingsplicht API (POST /melding)" edge="1" parent="1" source="actor-bs" target="actor-loket"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="arrow-6" style="endArrow=block;html=1;align=center;labelBackgroundColor=#ffffff;strokeColor=#909090;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=772;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=772;entryPerimeter=0;" value="&lt;b&gt;achteraf&lt;/b&gt;: na sync verschijnt je inzending&lt;br&gt;in de toezichtsdatabank" edge="1" parent="1" source="actor-loket" target="actor-wdb"><mxGeometry relative="1" x="-0.0204" y="-24" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
